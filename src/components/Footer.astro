---
const today = new Date();
const isCookbook = Astro.url.pathname.startsWith("/cookbook");
---

<footer
  class="border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-100/70 dark:bg-slate-950/70 backdrop-blur-md py-12 transition-colors duration-300"
>
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-200/60 dark:border-slate-800/60">
      <!-- Brand & Role -->
      <div class="text-center md:text-left">
        {
          isCookbook ? (
            <>
              <a
                href="/cookbook"
                class="text-lg font-bold tracking-tight text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >
                Coffey Cookbook
              </a>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Curated Culinary & Recipe Archive</p>
            </>
          ) : (
            <>
              <a
                href="/"
                class="text-lg font-bold tracking-tight text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >
                Brandon Coffey
              </a>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Lead Technical Artist & Graphics / XR Programmer</p>
            </>
          )
        }
      </div>

      <!-- Quick Links -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
        {
          isCookbook ? (
            <>
              <a href="/cookbook" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                All Recipes
              </a>
              <a href="/cookbook/favorites" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                Favorites
              </a>
              <a href="/cookbook/shopping-list" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                Shopping List
              </a>
              <a href="/cookbook/data" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                Diagnostics
              </a>
            </>
          ) : (
            <>
              <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                Portfolio
              </a>
              <a href="/projects" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                All Projects
              </a>
              <a href="/cv" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                Curriculum Vitae
              </a>
              <a href="/#contact" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                Contact
              </a>
            </>
          )
        }
      </nav>

      <!-- Social Icons with Accessible Tooltips -->
      <div class="flex items-center gap-3">
        <a
          href="mailto:business@brandoncoffey.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Send email to business@brandoncoffey.com"
          class="p-2.5 rounded-lg text-slate-600 hover:text-emerald-600 hover:bg-slate-200/60 dark:text-slate-400 dark:hover:text-emerald-400 dark:hover:bg-slate-800/60 transition-all"
          title="Email"
        >
          <svg class="h-5 w-5" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path
              d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/brandon-coffey-36a802191"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          class="p-2.5 rounded-lg text-slate-600 hover:text-emerald-600 hover:bg-slate-200/60 dark:text-slate-400 dark:hover:text-emerald-400 dark:hover:bg-slate-800/60 transition-all"
          title="LinkedIn"
        >
          <svg class="h-5 w-5" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path
              d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
            ></path>
          </svg>
        </a>
        <a
          href="https://github.com/BrandonMCoffey"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile"
          class="p-2.5 rounded-lg text-slate-600 hover:text-emerald-600 hover:bg-slate-200/60 dark:text-slate-400 dark:hover:text-emerald-400 dark:hover:bg-slate-800/60 transition-all"
          title="GitHub"
        >
          <svg class="h-5 w-5" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="pt-6 text-center text-xs text-slate-500 dark:text-slate-400">
      &copy; {today.getFullYear()} Brandon Coffey. Crafted with Astro 7 & Tailwind CSS v4.
    </div>
  </div>
</footer>
