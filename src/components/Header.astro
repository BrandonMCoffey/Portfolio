---
import ThemeToggle from "./ThemeToggle.astro";
import { HEADER_UI_TEXT, PORTFOLIO_NAV_LINKS, SITE_PROFILE, type NavLinkItem } from "../data/site";

const { pathname: currentPath } = Astro.url;
const isHomepage = currentPath === "/";
const isProjectsPage = currentPath.startsWith("/projects");
const isCvPage = currentPath.startsWith("/cv");

const getNavHref = (link: NavLinkItem) => {
  if (link.id === "home") {
    return isHomepage ? "#home" : "/";
  }
  return link.isPage ? link.pageHref : isHomepage ? `#${link.href}` : `/#${link.href}`;
};
---

<header
  class="site-header sticky top-0 z-50 backdrop-blur-md bg-[color-mix(in_srgb,var(--bg-page)_88%,transparent)] border-b border-[var(--border-subtle)] transition-colors duration-250"
>
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Brand -->
      <a
        href={isHomepage ? "#home" : "/"}
        class="group flex items-center gap-2.5 font-bold text-[var(--text-primary)] hover:text-[var(--text-primary)] transition-colors"
      >
        <span
          class="flex h-8 w-8 items-center justify-center bg-[var(--accent-primary)] text-[var(--accent-primary-fg)] font-mono text-xs font-semibold tracking-wider group-hover:scale-105 transition-transform"
        >
          {SITE_PROFILE.initials}
        </span>
        <div class="flex flex-col">
          <span class="font-heading text-base font-semibold leading-tight group-hover:text-[var(--accent-primary)] transition-colors">
            {SITE_PROFILE.name}
          </span>
          <span class="text-[10px] uppercase font-mono tracking-wider text-[var(--text-muted)] hidden sm:block">
            {SITE_PROFILE.roleShort}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="site-nav hidden md:flex items-center gap-1 lg:gap-1.5">
        {
          PORTFOLIO_NAV_LINKS.map((link) => {
            const isActive = (isProjectsPage && link.id === "projects") || (isCvPage && link.id === "cv");
            const linkHref = getNavHref(link);
            return (
              <a
                href={linkHref}
                data-nav-section={link.id}
                class:list={[
                  "nav-link px-3 py-1.5 rounded-[4px] text-xs font-mono uppercase tracking-wider transition-all duration-200",
                  isActive
                    ? "text-[var(--accent-primary)] font-semibold bg-[var(--accent-badge-bg)]"
                    : "text-[var(--text-secondary)] hover:text-[var(--accent-primary)] hover:bg-[var(--bg-elevated)]",
                ]}
              >
                {link.text}
              </a>
            );
          })
        }
      </nav>

      <!-- Action Controls: Theme Toggle, Mobile Menu -->
      <div class="flex items-center gap-2.5">
        <ThemeToggle />

        <!-- Mobile Hamburger Button -->
        <button
          id="portfolio-menu-btn"
          type="button"
          class="hamburger md:hidden p-1.5 rounded-[4px] text-[var(--text-secondary)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)]"
          aria-label={HEADER_UI_TEXT.menuToggleAriaLabel}
          aria-expanded="false"
          aria-controls="portfolio-mobile-menu"
        >
          <span class="hamburger-top"></span>
          <span class="hamburger-middle"></span>
          <span class="hamburger-bottom"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="portfolio-mobile-menu"
    class="hidden md:hidden border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] backdrop-blur-xl transition-all duration-250"
  >
    <div class="container mx-auto px-4 py-4 space-y-1">
      {
        PORTFOLIO_NAV_LINKS.map((link) => {
          const linkHref = getNavHref(link);
          return (
            <a
              href={linkHref}
              data-mobile-nav={link.id}
              class="mobile-nav-link block px-3 py-2.5 rounded-[4px] text-sm font-mono uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--accent-primary)] hover:bg-[var(--bg-elevated)] transition-colors"
            >
              {link.text}
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<script>
  function setupPortfolioNav() {
    const btn = document.getElementById("portfolio-menu-btn");
    const menu = document.getElementById("portfolio-mobile-menu");
    const isHome = window.location.pathname === "/" || window.location.pathname === "";
    const isProjects = window.location.pathname.startsWith("/projects");

    if (!btn || !menu || btn.dataset.hasListener) return;
    btn.dataset.hasListener = "true";

    const toggleMenu = () => {
      const isOpen = btn.classList.toggle("open");
      menu.classList.toggle("hidden", !isOpen);
      btn.setAttribute("aria-expanded", String(isOpen));
    };

    const closeMenu = () => {
      btn.classList.remove("open");
      menu.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
    };

    btn.addEventListener("click", toggleMenu);

    menu.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        closeMenu();
      }
    });

    const activeClasses = ["text-[var(--accent-primary)]", "font-semibold", "bg-[var(--accent-badge-bg)]"];
    const inactiveClasses = ["text-[var(--text-secondary)]"];

    if (isHome) {
      const sections = document.querySelectorAll("section[id]");
      const desktopNavLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link[data-nav-section]");

      if (sections.length > 0 && desktopNavLinks.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                desktopNavLinks.forEach((link) => {
                  const matches = link.dataset.navSection === id;
                  activeClasses.forEach((cls) => link.classList.toggle(cls, matches));
                  inactiveClasses.forEach((cls) => link.classList.toggle(cls, !matches));
                });
              }
            });
          },
          { root: null, rootMargin: "-20% 0px -60% 0px", threshold: 0 },
        );

        sections.forEach((sec) => observer.observe(sec));
      }
    } else if (isProjects) {
      const projectsNavLink = document.querySelector<HTMLAnchorElement>('.nav-link[data-nav-section="projects"]');
      if (projectsNavLink) {
        projectsNavLink.classList.add(...activeClasses);
        projectsNavLink.classList.remove(...inactiveClasses);
      }
    } else if (window.location.pathname.startsWith("/cv")) {
      const cvNavLink = document.querySelector<HTMLAnchorElement>('.nav-link[data-nav-section="cv"]');
      if (cvNavLink) {
        cvNavLink.classList.add(...activeClasses);
        cvNavLink.classList.remove(...inactiveClasses);
      }
    }
  }

  document.addEventListener("astro:page-load", setupPortfolioNav);
</script>
