---
import type { CollectionEntry } from "astro:content";
import { DEFAULT_FALLBACK_IMAGE } from "../../consts";
import { PROJECT_CARD_TEXT } from "../../data/projectsConfig";
import { resolveProjectThumbnail } from "../../utils/projectImages";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const slug = project.id;
const { title, thumbnail, tech = [], tagline, role, year, status, client, liveUrl, githubUrl, videoUrl } = project.data;
const thumbnailSrc = resolveProjectThumbnail(slug, thumbnail);
const visibleTech = tech.slice(0, 3);
---

<a
  href={`/projects/${slug}`}
  class="project-card card-spotlight group h-full"
  data-slug={slug}
  data-year={year}
  data-role={role}
  data-tech={tech.join(",")}
  data-filters={(project.data.filters || []).join(",")}
>
  <!-- Clean 16:9 Thumbnail Container -->
  <div class="relative aspect-video w-full overflow-hidden bg-[var(--bg-elevated)]">
    <img
      src={thumbnailSrc}
      alt={`Thumbnail for ${title}`}
      class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
      loading="lazy"
      decoding="async"
      transition:name={`project-img-${slug}`}
      onerror={`this.onerror=null; this.src='${DEFAULT_FALLBACK_IMAGE}';`}
    />

    <!-- Subtle Quick Action Icons -->
    <div class="absolute top-2.5 right-2.5 flex items-center gap-1.5 opacity-85 group-hover:opacity-100 transition-opacity">
      {
        liveUrl && (
          <span
            class="p-1.5 rounded-[2px] bg-[color-mix(in_srgb,var(--bg-page)_88%,transparent)] text-[var(--accent-primary)] border border-[var(--border-subtle)] backdrop-blur-xs"
            title={PROJECT_CARD_TEXT.liveDemoTitle}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              />
            </svg>
          </span>
        )
      }
      {
        githubUrl && (
          <span
            class="p-1.5 rounded-[2px] bg-[color-mix(in_srgb,var(--bg-page)_88%,transparent)] text-[var(--text-primary)] border border-[var(--border-subtle)] backdrop-blur-xs"
            title={PROJECT_CARD_TEXT.githubTitle}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
          </span>
        )
      }
      {
        videoUrl && (
          <span
            class="p-1.5 rounded-[2px] bg-[color-mix(in_srgb,var(--bg-page)_88%,transparent)] text-[var(--accent-primary)] border border-[var(--border-subtle)] backdrop-blur-xs"
            title={PROJECT_CARD_TEXT.videoTitle}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" />
            </svg>
          </span>
        )
      }
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-5 flex flex-col flex-1 justify-between">
    <div>
      <!-- Inline Year & Status Metadata -->
      <div class="flex items-center justify-between gap-2 mb-2.5 font-mono text-[11px]">
        <span class="text-[var(--text-muted)] font-semibold">{year}</span>
        {
          status && (
            <span class={status === "Released" ? "pill-status-released" : status === "In Development" ? "pill-status-dev" : "pill-status-ongoing"}>
              {status}
            </span>
          )
        }
      </div>

      <!-- Square Tech Tags (max 3) -->
      <div class="flex flex-wrap gap-1.5 mb-3">
        {visibleTech.map((t: string) => <span class="tag-square">{t}</span>)}
      </div>

      <!-- Title & Role -->
      <h3 class="text-lg font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-1 line-clamp-1">
        {title}
      </h3>
      {
        role && (
          <p class="text-xs font-mono font-medium text-[var(--accent-secondary)] mb-1.5">
            {role} {client && <span class="text-[var(--text-muted)] font-normal">&bull; {client}</span>}
          </p>
        )
      }
      <p class="text-[var(--text-secondary)] text-sm line-clamp-2 leading-relaxed">
        {tagline}
      </p>
    </div>

    <!-- Footer Link Indicator -->
    <div
      class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-mono uppercase tracking-wider text-[var(--text-muted)] group-hover:text-[var(--accent-primary)] transition-colors"
    >
      <span>{PROJECT_CARD_TEXT.ctaLabel}</span>
      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
    </div>
  </div>
</a>
