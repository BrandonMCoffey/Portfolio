---
import { resolveProjectImage } from "../../utils/projectImages";

interface Props {
  beforeImage: string;
  afterImage: string;
  alt: string;
  beforeText?: string;
  afterText?: string;
}

const { beforeImage, afterImage, alt, beforeText = "Before", afterText = "After" } = Astro.props;

const beforePath = resolveProjectImage(beforeImage, Astro.url.pathname);
const afterPath = resolveProjectImage(afterImage, Astro.url.pathname);
---

<div
  class="image-slider-wrapper not-prose my-8 aspect-video rounded-xl overflow-hidden select-none relative cursor-ew-resize border border-slate-200/80 dark:border-slate-800/80 shadow-lg"
  data-testid="image-slider"
  tabindex="0"
  role="slider"
  aria-label={`Comparison slider: ${beforeText} vs ${afterText}`}
  aria-valuenow="50"
  aria-valuemin="0"
  aria-valuemax="100"
>
  <!-- After Image -->
  <img src={afterPath} alt={alt} class="slider-image m-0 block" loading="lazy" draggable="false" />
  <div class="slider-clipped-after" style="clip-path: inset(0 0 0 50%);">
    <div class="slider-badge slider-badge-after">
      <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-900/75 text-white backdrop-blur-xs shadow-md whitespace-nowrap">
        {afterText}
      </span>
    </div>
  </div>

  <!-- Before Image -->
  <div class="slider-clipped-image" style="clip-path: inset(0 50% 0 0);">
    <img src={beforePath} alt={alt} class="slider-image slider-image-before m-0 block" loading="lazy" draggable="false" />
    <div class="slider-badge slider-badge-before">
      <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-900/75 text-white backdrop-blur-xs shadow-md whitespace-nowrap">
        {beforeText}
      </span>
    </div>
  </div>

  <!-- Divider Line & Drag Handle -->
  <div class="slider-line" style="left: 50%;">
    <div class="slider-handle shadow-xl shadow-slate-950/40">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15L12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" transform="rotate(90 12 12)"
        ></path>
      </svg>
    </div>
  </div>
</div>

<style>
  .slider-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    margin: 0;
    display: block;
  }
  .slider-image-before {
    object-position: center;
  }
  .slider-clipped-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(0 50% 0 0);
    pointer-events: none;
  }
  .slider-clipped-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(0 0 0 50%);
    pointer-events: none;
  }
  .slider-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: rgba(255, 255, 255, 0.9);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .slider-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 38px;
    height: 38px;
    background-color: rgba(15, 23, 42, 0.85);
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    backdrop-filter: blur(4px);
    transition:
      transform 0.15s ease,
      background-color 0.15s ease;
  }
  .image-slider-wrapper:focus .slider-handle,
  .image-slider-wrapper:hover .slider-handle {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: rgba(5, 150, 105, 0.9);
  }
  .slider-badge {
    position: absolute;
    bottom: 0.75rem;
    pointer-events: none;
    z-index: 10;
    white-space: nowrap;
  }
  .slider-badge-before {
    left: 0.75rem;
  }
  .slider-badge-after {
    right: 0.75rem;
  }
</style>

<script>
  function initImageSliders() {
    document.querySelectorAll<HTMLElement>('[data-testid="image-slider"]').forEach((wrapper) => {
      if (wrapper.dataset.hasListener) return;
      wrapper.dataset.hasListener = "true";

      let isDragging = false;
      let currentPercent = 50;

      const clippedImage = wrapper.querySelector<HTMLElement>(".slider-clipped-image");
      const clippedAfter = wrapper.querySelector<HTMLElement>(".slider-clipped-after");
      const sliderLine = wrapper.querySelector<HTMLElement>(".slider-line");

      const setPercentage = (pct: number) => {
        currentPercent = Math.max(0, Math.min(100, pct));
        if (clippedImage) clippedImage.style.clipPath = `inset(0 ${100 - currentPercent}% 0 0)`;
        if (clippedAfter) clippedAfter.style.clipPath = `inset(0 0 0 ${currentPercent}%)`;
        if (sliderLine) sliderLine.style.left = `${currentPercent}%`;
        wrapper.setAttribute("aria-valuenow", String(Math.round(currentPercent)));
      };

      const onDrag = (e: MouseEvent | TouchEvent) => {
        if (!isDragging) return;
        const rect = wrapper.getBoundingClientRect();
        const clientX = "touches" in e ? e.touches[0].clientX : e.clientX;
        const offsetX = clientX - rect.left;
        const percentage = (offsetX / rect.width) * 100;
        setPercentage(percentage);
      };

      const stopDragging = () => {
        if (!isDragging) return;
        isDragging = false;
        window.removeEventListener("mouseup", stopDragging);
        window.removeEventListener("mousemove", onDrag);
        window.removeEventListener("touchend", stopDragging);
        window.removeEventListener("touchmove", onDrag);
      };

      const startDragging = () => {
        isDragging = true;
        window.addEventListener("mouseup", stopDragging);
        window.addEventListener("mousemove", onDrag);
        window.addEventListener("touchend", stopDragging);
        window.addEventListener("touchmove", onDrag, { passive: true });
      };

      wrapper.addEventListener("mousedown", startDragging);
      wrapper.addEventListener("touchstart", startDragging, { passive: true });

      // Keyboard Arrow controls
      wrapper.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          setPercentage(currentPercent - 5);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          setPercentage(currentPercent + 5);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initImageSliders);
</script>
