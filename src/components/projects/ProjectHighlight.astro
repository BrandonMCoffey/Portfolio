---
import { PROJECT_COMPONENTS_TEXT } from "../../data/projectsConfig";

interface Props {
  title?: string;
  description?: string;
  // Defaults to 'Project Highlight' when title is provided.
  badge?: string;
  linkUrl?: string;
  linkText?: string;
  class?: string;
  className?: string;
}

const {
  title,
  description,
  badge,
  linkUrl,
  linkText = PROJECT_COMPONENTS_TEXT.highlightDefaultLinkText,
  class: extraClass = "",
  className = "",
} = Astro.props;

const customClasses = extraClass || className;
const hasTitle = Boolean(title && title.trim());
const hasDescription = Boolean(description && description.trim());
const showBadge = badge !== undefined ? Boolean(badge) : hasTitle;
const badgeLabel = badge || PROJECT_COMPONENTS_TEXT.highlightDefaultBadge;
---

<div
  class:list={[
    "highlight-wrapper not-prose my-8 relative overflow-hidden",
    "border-2 border-[var(--border-strong)] border-l-4 border-l-[var(--accent-primary)]",
    "bg-[var(--bg-surface)] p-6 sm:p-7",
    "shadow-[4px_4px_0px_var(--border-subtle)] transition-all duration-200 hover:border-[var(--accent-primary)]",
    customClasses,
  ]}
  role="region"
  aria-label={title || PROJECT_COMPONENTS_TEXT.highlightDefaultBadge}
>
  <div class="relative z-10 flex flex-col gap-2.5">
    {
      showBadge && (
        <div class="flex items-center gap-2">
          <span class="tag-accent gap-1.5 px-2.5 py-1 text-[11px] uppercase tracking-wider">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 text-[var(--accent-primary)] shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="6" />
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
            </svg>
            <span>{badgeLabel}</span>
          </span>
        </div>
      )
    }

    {hasTitle && <h3 class="text-lg sm:text-xl font-semibold text-[var(--text-primary)] leading-snug tracking-tight m-0">{title}</h3>}

    {hasDescription && <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed m-0 font-normal">{description}</p>}

    {
      Astro.slots.has("default") && (
        <div class="highlight-slot token-prose mt-2 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed prose prose-neutral dark:prose-invert max-w-none prose-p:my-2 prose-a:text-[var(--accent-primary)]">
          <slot />
        </div>
      )
    }

    {
      linkUrl && (
        <div class="mt-2 pt-3 border-t border-[var(--border-subtle)]">
          <a
            href={linkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] transition-colors"
          >
            <span>{linkText}</span>
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</div>
