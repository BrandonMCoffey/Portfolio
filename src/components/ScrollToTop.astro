---
import { UI_COMMON_TEXT } from "../data/site";
---

<button
  id="scroll-to-top-btn"
  type="button"
  aria-label={UI_COMMON_TEXT.scrollToTopAriaLabel}
  title={UI_COMMON_TEXT.scrollToTopTitle}
  class="scroll-to-top fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-[6px] bg-[var(--bg-surface)] backdrop-blur-md border border-[var(--border-strong)] text-[var(--accent-primary)] shadow-lg opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:scale-105 hover:border-[var(--accent-primary)] active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)]"
>
  <!-- Circular SVG Progress Ring -->
  <svg class="absolute inset-0 h-full w-full -rotate-90 transform p-1.5" viewBox="0 0 36 36">
    <path
      class="text-[var(--border-subtle)] stroke-current"
      stroke-width="3"
      fill="none"
      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
    <path
      id="scroll-progress-ring"
      class="text-[var(--accent-primary)] stroke-current transition-all duration-150"
      stroke-width="3"
      stroke-linecap="square"
      stroke-dasharray="100, 100"
      stroke-dashoffset="100"
      fill="none"
      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
  </svg>
  <!-- Arrow Icon -->
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="relative h-5 w-5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
  </svg>
</button>

<script>
  import { SCROLL_TO_TOP_THRESHOLD_PX } from "../consts";

  function initScrollToTop() {
    const btn = document.getElementById("scroll-to-top-btn");
    const ring = document.getElementById("scroll-progress-ring");
    if (!btn || !ring || btn.dataset.hasListener) return;
    btn.dataset.hasListener = "true";

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const updateScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? Math.min(100, Math.max(0, (scrollY / docHeight) * 100)) : 0;

      ring.style.strokeDashoffset = `${100 - scrollPercent}`;

      if (scrollY > SCROLL_TO_TOP_THRESHOLD_PX) {
        btn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
        btn.classList.add("opacity-100", "translate-y-0");
      } else {
        btn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
        btn.classList.remove("opacity-100", "translate-y-0");
      }
    };

    if ((window as any).__scrollToTopHandler) {
      window.removeEventListener("scroll", (window as any).__scrollToTopHandler);
    }
    (window as any).__scrollToTopHandler = updateScroll;
    window.addEventListener("scroll", updateScroll, { passive: true });
    updateScroll();

    btn.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? "auto" : "smooth",
      });
    });
  }

  document.addEventListener("astro:before-swap", () => {
    if ((window as any).__scrollToTopHandler) {
      window.removeEventListener("scroll", (window as any).__scrollToTopHandler);
      (window as any).__scrollToTopHandler = null;
    }
  });

  document.addEventListener("astro:page-load", initScrollToTop);
</script>
