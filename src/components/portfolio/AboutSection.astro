---
import { loadSectionContent, resolveCtaLink } from "../../utils/sectionContent";
import SectionWrapper from "./SectionWrapper.astro";

const { data, Content } = await loadSectionContent("about");
---

<SectionWrapper id="about" title={data.title}>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Bio & Background (5 cols) -->
      <div class="lg:col-span-5">
        <div class="card-primary card-spotlight p-6 sm:p-7">
          <h3 class="text-xl font-semibold text-[var(--text-primary)] mb-4">{data.bioHeading}</h3>
          <div class="token-prose space-y-4 text-sm sm:text-base leading-relaxed">
            <Content />
          </div>

          <div class="mt-6 pt-5 border-t border-[var(--border-subtle)] flex flex-wrap items-center gap-3">
            {
              data.ctas.map((cta) => {
                const { href, isExternal } = resolveCtaLink(cta);
                return (
                  <a
                    href={href}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                    class:list={[
                      "btn text-xs px-4 py-2",
                      cta.variant === "primary" ? "btn-primary" : "btn-secondary",
                      cta.emphasize && "font-semibold",
                    ]}
                  >
                    {cta.label}
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>

      <!-- Technical Proficiency Bento Grid (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          data.skillCategories.map((cat) => (
            <div class="card-primary card-spotlight p-5">
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg" role="img" aria-hidden="true">
                    {cat.icon}
                  </span>
                  <h4 class="text-sm font-semibold text-[var(--text-primary)]">{cat.title}</h4>
                </div>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {cat.skills.map((skill) => (
                  <span class="tag-square">{skill}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</SectionWrapper>
