---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id}>
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="inline-block relative">
        {title}
        <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-2/3 h-1 bg-emerald-500 rounded-full"></span>
      </h2>
    </div>
    <slot />
  </div>
</section>
