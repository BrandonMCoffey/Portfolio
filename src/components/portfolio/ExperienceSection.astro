---
import { getCollection, render } from "astro:content";
import { loadSectionContent } from "../../utils/sectionContent";
import SectionWrapper from "./SectionWrapper.astro";

const { data: intro, Content: IntroContent } = await loadSectionContent("experience-intro");

const experienceEntries = await getCollection("experience");
experienceEntries.sort((a, b) => a.data.order - b.data.order);

const renderedExperiences = await Promise.all(
  experienceEntries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);
---

<SectionWrapper id="experience" title={intro.title}>
  <div class="max-w-3xl mx-auto text-center mb-12 -mt-4">
    <div class="token-prose text-base sm:text-lg text-[var(--text-secondary)] [&>p]:m-0">
      <IntroContent />
    </div>
  </div>

  <div class="max-w-4xl mx-auto">
    <div class="space-y-8">
      {
        renderedExperiences.map(({ data: exp, Content }) => (
          <div class="card-brutal card-spotlight p-6 sm:p-7">
            <!-- Top metadata header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 mb-4 border-b border-[var(--border-subtle)]">
              <div>
                <span class="tag-accent uppercase tracking-wider mb-2">
                  {exp.company}
                </span>
                <h3 class="text-xl font-semibold text-[var(--text-primary)] leading-tight">{exp.role}</h3>
              </div>
              <div class="text-left sm:text-right">
                <time class="text-xs font-mono font-semibold text-[var(--accent-secondary)] block">{exp.time}</time>
                <span class="text-xs font-mono text-[var(--text-muted)]">{exp.location}</span>
              </div>
            </div>

            <!-- Description -->
            <div class="token-prose text-sm sm:text-base text-[var(--text-secondary)] mb-4 leading-relaxed [&>p]:m-0">
              <Content />
            </div>

            <!-- Key takeaways / achievements -->
            <ul class="space-y-2 mb-5">
              {exp.takeaways.map((item) => (
                <li class="flex items-start text-xs sm:text-sm text-[var(--text-secondary)]">
                  <span class="font-mono font-bold text-[var(--accent-primary)] shrink-0 mr-2.5 mt-0.5">+</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <!-- Awards & Lab Link Footer -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-4 border-t border-[var(--border-subtle)]">
              {exp.awards && exp.awards.length > 0 ? (
                <div class="flex flex-wrap items-center gap-1.5">
                  {exp.awards.map((award) => (
                    <span class="tag-square-secondary">
                      {award}
                    </span>
                  ))}
                </div>
              ) : (
                <div />
              )}

              <a
                href={exp.filterLink}
                class="inline-flex items-center font-mono text-xs font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] transition-colors"
              >
                {exp.filterText}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</SectionWrapper>
