---
import { SITE_PROFILE } from "../../data/site";
import { loadSectionContent, resolveCtaLink } from "../../utils/sectionContent";

const { data, Content } = await loadSectionContent("hero");

const prefixWords = data.headlinePrefix.trim().split(/\s+/);
const highlightWords = data.headlineHighlight.trim().split(/\s+/);
const suffixWords = data.headlineSuffix.trim().split(/\s+/);
---

<section id="home" class="relative overflow-hidden border-b border-[var(--border-subtle)] py-16 sm:py-24 lg:py-28">
  <!-- Interactive Halftone Dot Grid WebGL Background Shader -->
  <canvas
    id="hero-bg-shader"
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <div class="container relative z-10 mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <div class="hero-fg-title-wrap mb-6">
          <canvas
            id="hero-fg-shader"
            class="hero-fg-canvas"
            aria-hidden="true"
          ></canvas>
          <h1 id="hero-title" class="relative z-1">
            {prefixWords.map((w) => (
              <>
                <span class="hero-fg-word inline-block" data-hl="0">{w}</span>{" "}
              </>
            ))}
            {highlightWords.map((w) => (
              <>
                <span class="hero-fg-word inline-block text-[var(--accent-primary)]" data-hl="1">{w}</span>{" "}
              </>
            ))}
            {suffixWords.map((w, i) => (
              <>
                <span class="hero-fg-word inline-block" data-hl="0">{w}</span>{i < suffixWords.length - 1 ? " " : ""}
              </>
            ))}
          </h1>
        </div>

        <!-- Value Proposition -->
        <div
          class="token-prose text-base sm:text-lg text-[var(--text-secondary)] mb-8 leading-[1.65] max-w-2xl mx-auto lg:mx-0 [&>p]:m-0"
        >
          <Content />
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3.5">
          {
            data.ctas.map((cta) => {
              const { href, isExternal } = resolveCtaLink(cta);
              return (
                <a
                  href={href}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class:list={[
                    "btn text-sm sm:text-base px-6 py-3",
                    cta.variant === "primary" ? "btn-primary" : "btn-secondary",
                    cta.emphasize && "font-semibold",
                  ]}
                >
                  {cta.label}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Right Column: Brutalist Profile Spec Card (5 cols) -->
      <div class="lg:col-span-5">
        <div class="card-primary card-spotlight p-6">
          <!-- Top profile bar + Connect icons -->
          <div class="flex items-start justify-between gap-4 mb-5 pb-5 border-b border-[var(--border-subtle)]">
            <div class="flex items-center gap-4 min-w-0">
              <div class="h-16 w-16 shrink-0 border-2 border-[var(--accent-primary)] p-0.5 overflow-hidden">
                <img
                  src={SITE_PROFILE.avatar}
                  alt={SITE_PROFILE.name}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
              </div>
              <div class="min-w-0">
                <h3 class="text-base font-semibold text-[var(--text-primary)]">{SITE_PROFILE.name}</h3>
                <p class="text-xs text-[var(--accent-secondary)] font-mono mt-0.5">{SITE_PROFILE.heroSubtitle}</p>
                <p class="text-[11px] text-[var(--text-muted)] font-mono mt-0.5">{SITE_PROFILE.location}</p>
              </div>
            </div>

            <!-- Social Links (Top Right) -->
            <div class="flex items-center gap-3 shrink-0 pt-0.5">
              <a
                href={`mailto:${SITE_PROFILE.email}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors"
                title="Email"
                aria-label="Email"
              >
                <svg class="h-6 w-6" viewBox="0 0 16 16" fill="currentColor"
                  ><path
                    d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"
                  ></path></svg
                >
              </a>
              <a
                href={SITE_PROFILE.github.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors"
                title={SITE_PROFILE.github.label}
                aria-label={SITE_PROFILE.github.label}
              >
                <svg class="h-6 w-6" viewBox="0 0 16 16" fill="currentColor"
                  ><path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                  ></path></svg
                >
              </a>
              <a
                href={SITE_PROFILE.linkedin.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors"
                title={SITE_PROFILE.linkedin.label}
                aria-label={SITE_PROFILE.linkedin.label}
              >
                <svg class="h-6 w-6" viewBox="0 0 16 16" fill="currentColor"
                  ><path
                    d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
                  ></path></svg
                >
              </a>
            </div>
          </div>

          <!-- Primary Tech Stack -->
          <div>
            <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-2.5">{data.toolkitLabel}</div>
            <div class="flex flex-wrap gap-1.5">
              {data.toolkit.map((item) => <span class="tag-square">{item}</span>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountHeroBgShader } from "../../scripts/shaders/heroBgShader";
  import { mountHeroTitleShader } from "../../scripts/shaders/heroTitleShader";

  let cleanupBg: (() => void) | null = null;
  let cleanupFg: (() => void) | null = null;

  function setupHeroShaders() {
    cleanupBg?.();
    cleanupFg?.();
    cleanupBg = null;
    cleanupFg = null;

    const bgCanvas = document.getElementById("hero-bg-shader") as HTMLCanvasElement | null;
    if (bgCanvas) {
      cleanupBg = mountHeroBgShader(bgCanvas);
    }

    const titleEl = document.getElementById("hero-title");
    const fgCanvas = document.getElementById("hero-fg-shader") as HTMLCanvasElement | null;
    if (titleEl && fgCanvas) {
      cleanupFg = mountHeroTitleShader(titleEl, fgCanvas);
    }
  }

  document.addEventListener("astro:page-load", setupHeroShaders);
  document.addEventListener("astro:before-swap", () => {
    cleanupBg?.();
    cleanupFg?.();
    cleanupBg = null;
    cleanupFg = null;
  });
</script>
