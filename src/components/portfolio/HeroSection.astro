---
// HeroSection.astro
---

<section id="home" class="relative overflow-hidden py-16 sm:py-24 md:py-28">
  <!-- Background grid pattern with radial fade -->
  <div
    class="pointer-events-none absolute inset-0 bg-grid-pattern opacity-60 [mask-image:radial-gradient(ellipse_at_center,black_45%,transparent_80%)]"
  >
  </div>

  <!-- Ambient soft glow circles -->
  <div
    class="pointer-events-none absolute top-1/4 left-1/4 -translate-y-1/2 h-96 w-96 rounded-full bg-emerald-500/10 dark:bg-emerald-500/15 blur-3xl"
  >
  </div>
  <div class="pointer-events-none absolute top-1/2 right-1/4 h-80 w-80 rounded-full bg-teal-500/10 dark:bg-teal-500/15 blur-3xl"></div>

  <div class="container relative mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <!-- Badges Row -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 mb-6">
          <div
            class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 dark:bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 backdrop-blur-xs shadow-xs"
          >
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            Lead Technical Artist & XR Programmer
          </div>
          <div
            class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 dark:bg-amber-500/15 px-3 py-1 text-xs font-semibold text-amber-800 dark:text-amber-300 backdrop-blur-xs shadow-xs"
          >
            <span>🏆</span>
            <span>5× Davey Award Winner (1 Gold, 4 Silver)</span>
          </div>
          <div
            class="inline-flex items-center gap-1.5 rounded-full border border-teal-500/30 bg-teal-500/10 dark:bg-teal-500/15 px-3 py-1 text-xs font-semibold text-teal-800 dark:text-teal-300 backdrop-blur-xs shadow-xs"
          >
            <span>⚡</span>
            <span>Tech Titans 2026 Finalist</span>
          </div>
        </div>

        <!-- Main Headline -->
        <h1 class="mb-6 tracking-tight text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white leading-[1.1]">
          Crafting High-Performance{" "}
          <span
            class="bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400 bg-clip-text text-transparent"
          >
            Real-Time Graphics
          </span>{" "}
          & Immersive Worlds
        </h1>

        <!-- Value Proposition -->
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 mb-8 leading-relaxed font-normal max-w-2xl mx-auto lg:mx-0">
          Specializing in Unreal Engine, Unity, custom shaders, and cross-platform XR pipelines. Bridging the gap between cutting-edge visual fidelity
          and rock-solid systems engineering.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3.5 mb-8">
          <a href="/#projects" class="btn btn-primary text-sm sm:text-base px-6 py-3 shadow-md shadow-emerald-600/20"> Explore Projects </a>
          <a href="/cv" class="btn btn-secondary text-sm sm:text-base px-6 py-3 font-semibold"> CV & Research </a>
          <a href="/#contact" class="btn btn-secondary text-sm sm:text-base px-6 py-3"> Get In Touch </a>
        </div>

        <!-- Social Links -->
        <div class="flex items-center justify-center lg:justify-start gap-4 text-slate-500 dark:text-slate-400">
          <span class="text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">Connect:</span>
          <a
            href="https://github.com/BrandonMCoffey"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
            title="GitHub"
          >
            <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.linkedin.com/in/brandon-coffey-36a802191"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
            title="LinkedIn"
          >
            <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
              ></path></svg
            >
          </a>
          <a
            href="mailto:business@brandoncoffey.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
            title="Email"
          >
            <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Bento Highlights (5 cols) -->
      <div class="lg:col-span-5">
        <div
          class="relative rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md p-6 shadow-xl shadow-slate-950/5 card-glow"
        >
          <!-- Top profile bar -->
          <div class="flex items-center gap-4 mb-6 pb-5 border-b border-slate-200/60 dark:border-slate-800/60">
            <img
              src="/profile-picture.png"
              alt="Brandon Coffey"
              class="h-16 w-16 rounded-xl object-cover ring-2 ring-emerald-500/30 shadow-md"
              loading="eager"
            />
            <div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">Brandon Coffey</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">UT Dallas MFA &bull; VAST Lab</p>
              <div class="flex items-center gap-2 mt-1">
                <span
                  class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300"
                >
                  Available for Select Roles
                </span>
              </div>
            </div>
          </div>

          <!-- Key Highlights Bento -->
          <div class="space-y-3 mb-6">
            <div class="text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">Featured Showcase:</div>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <a
                href="/projects/woodbearers"
                class="p-2.5 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 hover:bg-emerald-500/10 border border-slate-200/60 dark:border-slate-700/60 transition-colors block"
              >
                <span class="font-bold text-slate-800 dark:text-slate-200 block truncate">Woodbearers VR</span>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400">Award-winning VR</span>
              </a>
              <a
                href="/projects/faa-techops"
                class="p-2.5 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 hover:bg-emerald-500/10 border border-slate-200/60 dark:border-slate-700/60 transition-colors block"
              >
                <span class="font-bold text-slate-800 dark:text-slate-200 block truncate">FAA TechOps</span>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400">HoloLens XR Training</span>
              </a>
              <a
                href="/projects/kitty-city"
                class="p-2.5 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 hover:bg-emerald-500/10 border border-slate-200/60 dark:border-slate-700/60 transition-colors block"
              >
                <span class="font-bold text-slate-800 dark:text-slate-200 block truncate">Kitty City AR</span>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400">Quest Pro / NYT Feature</span>
              </a>
              <a
                href="/projects/coffey-utils"
                class="p-2.5 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 hover:bg-emerald-500/10 border border-slate-200/60 dark:border-slate-700/60 transition-colors block"
              >
                <span class="font-bold text-slate-800 dark:text-slate-200 block truncate">Coffey Utils</span>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400">Unity Tools Package</span>
              </a>
            </div>
          </div>

          <!-- Primary Tech Stack Pills -->
          <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800/60">
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">Primary Toolkit:</div>
            <div class="flex flex-wrap gap-1.5">
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">Unreal Engine 5</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">Unity</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">C++</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">C#</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">HLSL / Shaders</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">Python / Qt</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">Houdini</span>
              <span class="badge bg-slate-200/70 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300">OpenXR</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
