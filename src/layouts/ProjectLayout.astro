---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { publications, mediaRecognition, type PublicationItem, type MediaRecognitionItem } from '../data/cvData';
import { INTERACTIVE_DEMO_HOSTS, PROJECT_LAYOUT_TEXT, PROJECT_SETTINGS } from '../data/projectsConfig';
import { SITE_PROFILE, formatTemplate } from '../data/site';
import { getTechLink } from '../data/techLinks';
import { resolveProjectThumbnail } from '../utils/projectImages';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsHidden'>;

interface Props {
	project: ProjectEntry['data'];
	slug?: string;
	headings?: Heading[];
	prevProject?: ProjectEntry;
	nextProject?: ProjectEntry;
	detailBasePath?: string;
	noindex?: boolean;
	academicSpotlight?: PublicationItem;
	mediaSpotlight?: MediaRecognitionItem;
	backLink?: { href: string; label: string };
}

const {
	project,
	slug = '',
	headings = [],
	prevProject,
	nextProject,
	detailBasePath = '/projects',
	noindex = false,
	academicSpotlight,
	mediaSpotlight,
	backLink = PROJECT_LAYOUT_TEXT.defaultBackLink
} = Astro.props;

const { title, tagline, role, tech, platform, liveUrl, githubUrl, videoUrl, year, thumbnail, status, client } = project;
const thumbnailSrc = resolveProjectThumbnail(slug, thumbnail);

const TOC_HEADING_DEPTHS = new Set([2, 3]);
const TOC_MIN_HEADINGS = 2;

const tocHeadings = headings.filter(h => TOC_HEADING_DEPTHS.has(h.depth));
const hasToc = tocHeadings.length >= TOC_MIN_HEADINGS;

const projectPublications = publications.filter(p => p.projectSlug === slug);
const projectMedia = mediaRecognition.filter(m => m.projectSlug === slug);

const isInteractiveLiveDemo = Boolean(liveUrl && INTERACTIVE_DEMO_HOSTS.some(host => liveUrl.includes(host)));
const txt = PROJECT_LAYOUT_TEXT;
---

<BaseLayout title={`${title} | ${SITE_PROFILE.name}`} description={tagline} noindex={noindex}>
	<div class="relative overflow-x-clip py-10 sm:py-16">
		<div class="container relative mx-auto px-4 max-w-5xl">
			<!-- Breadcrumb Navigation Bar -->
			<nav class="flex flex-wrap items-center justify-between gap-3 py-3 px-4 mb-8 border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs font-mono text-[var(--text-muted)]">
				<a
					id="project-back-link"
					href={backLink.href}
					data-custom-back={backLink.href !== txt.defaultBackLink.href ? "1" : "0"}
					class="inline-flex items-center gap-1.5 font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
					<span id="project-back-label">{backLink.label}</span>
				</a>

				<div class="flex items-center gap-2">
					{status && (
						<span class={status === 'Released' ? 'pill-status-released' : status === 'Hidden' ? 'pill-status-hidden' : status === 'In Development' ? 'pill-status-dev' : 'pill-status-ongoing'}>
							{status}
						</span>
					)}
					{year && (
						<span class="tag-square font-bold">
							{year}
						</span>
					)}
					<span class="hidden sm:inline">&bull;</span>
					<span class="hidden sm:inline font-sans text-[var(--text-primary)] font-semibold">{role}</span>
				</div>
			</nav>

			<!-- Academic Paper Spotlight Hero -->
			{academicSpotlight && (
				<div class="card-primary card-spotlight mb-10 p-6 sm:p-8">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
						<span class="tag-accent px-3 py-1 text-xs font-bold">
							{txt.academicSpotlight.badge}
						</span>
						<span class="text-xs font-mono text-[var(--text-muted)]">
							{txt.academicSpotlight.dateLabel} <strong class="text-[var(--text-primary)]">{academicSpotlight.date}</strong> &bull; {txt.academicSpotlight.rolesLabel} <strong class="text-[var(--text-primary)]">{academicSpotlight.roles}</strong>
						</span>
					</div>

					<span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent-primary)] block mb-1.5">
						{academicSpotlight.venue}
					</span>

					<h2 class="text-2xl sm:text-3xl text-[var(--text-primary)] mb-4 leading-snug">
						{academicSpotlight.title}
					</h2>

					{academicSpotlight.abstract && (
						<div class="mb-6 border border-[var(--border-subtle)] bg-[var(--bg-elevated)] p-5 sm:p-6">
							<div class="flex items-center gap-2 mb-2.5 text-xs font-mono font-bold tracking-wider uppercase text-[var(--accent-primary)]">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
								<span>{txt.academicSpotlight.abstractTitle}</span>
							</div>
							<p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
								{academicSpotlight.abstract}
							</p>
						</div>
					)}

					<p class="text-sm text-[var(--text-secondary)] mb-6 leading-relaxed">
						{formatTemplate(txt.academicSpotlight.introTemplate, { title })}
					</p>

					<div class="flex flex-wrap items-center gap-3 pt-4 border-t border-[var(--border-subtle)] text-xs font-mono">
						{academicSpotlight.doi && (
							<a
								href={academicSpotlight.doi}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-primary px-3.5 py-2 text-xs"
							>
								<span>{txt.academicSpotlight.doiLabel}</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
							</a>
						)}
						{academicSpotlight.paperUrl && (
							<a
								href={academicSpotlight.paperUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-secondary px-3.5 py-2 text-xs"
							>
								<span>{txt.academicSpotlight.pdfLabel}</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
							</a>
						)}
						{academicSpotlight.extraUrl && (
							<a
								href={academicSpotlight.extraUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-secondary px-3.5 py-2 text-xs"
							>
								<span>{txt.academicSpotlight.archiveLabel}</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
							</a>
						)}
						<a
							href={txt.cvPublicationBackLink.href}
							class="ml-auto inline-flex items-center gap-1 text-[var(--text-muted)] hover:text-[var(--accent-primary)] font-semibold transition-colors"
						>
							{txt.academicSpotlight.allPublicationsLabel}
						</a>
					</div>
				</div>
			)}

			<!-- Press & Media Spotlight Hero -->
			{mediaSpotlight && (
				<div class="card-primary card-spotlight mb-10 p-6 sm:p-8">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
						<span class="tag-accent px-3 py-1 text-xs font-bold">
							{txt.mediaSpotlight.badge}
						</span>
						<span class="text-xs font-mono text-[var(--text-muted)]">
							{txt.mediaSpotlight.publishedLabel} <strong class="text-[var(--text-primary)]">{mediaSpotlight.date}</strong>
						</span>
					</div>

					<span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent-primary)] block mb-1.5">
						{txt.mediaSpotlight.featuredInPrefix} {mediaSpotlight.outlet}
					</span>

					<h2 class="text-2xl sm:text-3xl text-[var(--text-primary)] mb-4 leading-snug">
						"{mediaSpotlight.title}"
					</h2>

					<p class="text-sm text-[var(--text-secondary)] mb-6 leading-relaxed">
						{formatTemplate(txt.mediaSpotlight.introTemplate, { title })}
					</p>

					<div class="flex flex-wrap items-center gap-3 pt-4 border-t border-[var(--border-subtle)] text-xs font-mono">
						{mediaSpotlight.articleUrl && (
							<a
								href={mediaSpotlight.articleUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-primary px-3.5 py-2 text-xs"
							>
								<span>{txt.mediaSpotlight.articleLabel}</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
							</a>
						)}
						{mediaSpotlight.videoUrl && (
							<a
								href={mediaSpotlight.videoUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-secondary px-3.5 py-2 text-xs"
							>
								<span>{txt.mediaSpotlight.videoLabel}</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
							</a>
						)}
						{mediaSpotlight.podcastUrl && (
							<a
								href={mediaSpotlight.podcastUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-secondary px-3.5 py-2 text-xs"
							>
								<span>{txt.mediaSpotlight.podcastLabel}</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
							</a>
						)}
					</div>
				</div>
			)}

			<!-- Hero Title & Tagline -->
			<div class="text-center mb-10">
				<h1 class="mb-3 text-3xl sm:text-4xl md:text-5xl">
					{title}
				</h1>
				<p class="text-base sm:text-xl text-[var(--text-secondary)] italic font-normal max-w-2xl mx-auto">
					{tagline}
				</p>
			</div>

			<!-- Featured Image with View Transition -->
			{PROJECT_SETTINGS.showDetailThumbnail && thumbnailSrc && (
				<div class="mb-10 rounded-[3px] overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
					<img
						src={thumbnailSrc}
						alt={`Key art for ${title}`}
						transition:name={`project-img-${slug}`}
						class="w-full aspect-video object-cover"
						loading="eager"
						decoding="async"
					/>
				</div>
			)}

			<!-- Metadata Bar -->
			<div class="surface-card card-spotlight mb-12 p-6">
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
					<!-- Role -->
					<div>
						<span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block mb-1.5">
							{txt.metadata.roleHeading}
						</span>
						<p class="text-sm font-semibold text-[var(--text-primary)]">
							{role}
						</p>
						{client && (
							<p class="text-xs text-[var(--accent-primary)] font-mono mt-0.5 font-semibold">
								{txt.metadata.clientPrefix} {client}
							</p>
						)}
						{year && <p class="text-xs text-[var(--text-muted)] font-mono mt-0.5">{txt.metadata.yearPrefix} {year}</p>}
					</div>

					<!-- Platform -->
					<div>
						<span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block mb-1.5">
							{txt.metadata.platformHeading}
						</span>
						<div class="flex flex-wrap gap-1.5">
							{platform.map((p: string) => (
								<span class="tag-square-secondary">
									{p}
								</span>
							))}
						</div>
					</div>

					<!-- Tech Stack -->
					<div>
						<span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block mb-1.5">
							{txt.metadata.techHeading}
						</span>
						<div class="flex flex-wrap gap-1.5">
							{tech.map((t: string) => {
								const link = PROJECT_SETTINGS.enableTechStackLinks ? getTechLink(t) : undefined;
								if (link) {
									return (
										<a
											href={link}
											target="_blank"
											rel="noopener noreferrer"
											class="tag-accent gap-1 hover:opacity-90 transition-opacity group"
											title={formatTemplate(txt.metadata.techTooltipTemplate, { tech: t })}
										>
											<span>{t}</span>
											<svg class="h-2.5 w-2.5 opacity-60 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
										</a>
									);
								}
								return (
									<span class="tag-square">
										{t}
									</span>
								);
							})}
						</div>
					</div>

					<!-- Action CTAs -->
					<div class="flex flex-col justify-center gap-2">
						<span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block mb-0.5">
							{txt.metadata.linksHeading}
						</span>
						<div class="flex flex-wrap gap-2">
							{isInteractiveLiveDemo && (
								<a href={liveUrl} class="btn btn-primary text-xs px-3 py-1.5 flex-1 text-center" target="_blank" rel="noopener noreferrer">
									{txt.metadata.liveDemoLabel}
								</a>
							)}
							{githubUrl && (
								<a href={githubUrl} class="btn btn-secondary text-xs px-3 py-1.5 flex-1 text-center" target="_blank" rel="noopener noreferrer">
									{txt.metadata.githubLabel}
								</a>
							)}
							{videoUrl && (
								<a href={videoUrl} class="btn btn-secondary text-xs px-3 py-1.5 flex-1 text-center" target="_blank" rel="noopener noreferrer">
									{txt.metadata.videoLabel}
								</a>
							)}
							{!isInteractiveLiveDemo && !githubUrl && !videoUrl && (
								<span class="text-xs text-[var(--text-muted)] italic">{txt.metadata.fallbackLabel}</span>
							)}
						</div>
					</div>
				</div>
			</div>

			<!-- Main Article & Optional TOC Sidebar Grid -->
			<div class:list={[hasToc ? "lg:grid lg:grid-cols-12 lg:gap-12 items-start" : "max-w-3xl mx-auto"]}>
				<article class:list={[
					"prose prose-neutral dark:prose-invert max-w-none token-prose",
					hasToc ? "lg:col-span-8" : "",
					"prose-headings:font-semibold prose-headings:tracking-tight",
					"prose-h2:text-2xl prose-h2:border-b prose-h2:border-[var(--border-subtle)] prose-h2:pb-2.5 prose-h2:mt-10",
					"prose-h3:text-xl prose-h3:border-b prose-h3:border-[var(--border-subtle)] prose-h3:pb-2 prose-h3:mt-8 prose-h3:mb-3",
					"prose-a:text-[var(--accent-primary)] prose-a:font-semibold hover:prose-a:underline",
					"prose-img:rounded-[3px]",
					"prose-p:leading-relaxed"
				]}>
					<slot />

					<!-- Academic Publications Section -->
					{projectPublications.length > 0 && (
						<section class="mt-14 pt-8 border-t border-[var(--border-subtle)] not-prose">
							<div class="flex items-center gap-3 mb-6">
								<div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
									<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
								</div>
								<div>
									<h3 class="text-xl font-semibold text-[var(--text-primary)]">{txt.publicationsSection.title}</h3>
									<p class="text-xs text-[var(--text-muted)] font-mono">{txt.publicationsSection.subtitle}</p>
								</div>
							</div>

							<div class="space-y-4">
								{projectPublications.map(pub => (
									<div class="card-primary card-spotlight p-5 sm:p-6">
										<div class="flex items-start justify-between gap-3 mb-2">
											<span class="text-xs font-mono font-medium text-[var(--text-muted)]">{pub.venue}</span>
											<span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{pub.date}</span>
										</div>

										<h4 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] mb-2 leading-snug">
											{pub.title}
										</h4>

										<p class="text-xs font-mono text-[var(--text-muted)] mb-3">
											{txt.publicationsSection.rolesLabel} <strong class="text-[var(--text-secondary)]">{pub.roles}</strong>
										</p>

										{pub.abstract && (
											<div class="mb-4 p-3 bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] leading-relaxed">
												<span class="font-mono font-bold uppercase tracking-wider text-[10px] text-[var(--text-muted)] block mb-1">
													{txt.publicationsSection.abstractLabel}
												</span>
												<p class="line-clamp-3 hover:line-clamp-none transition-all">{pub.abstract}</p>
											</div>
										)}

										<div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[var(--border-subtle)] text-xs font-mono">
											<div class="flex flex-wrap items-center gap-3">
												{pub.doi && (
													<a
														href={pub.doi}
														target="_blank"
														rel="noopener noreferrer"
														class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
													>
														{txt.publicationsSection.doiLabel}
													</a>
												)}
												{pub.paperUrl && (
													<a
														href={pub.paperUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
													>
														{txt.publicationsSection.pdfLabel}
													</a>
												)}
											</div>
											<a
												href={`/cv/publications/${pub.id}`}
												class="inline-flex items-center gap-1 ml-auto font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
											>
												<span>{txt.publicationsSection.caseStudyLabel}</span>
												<span>&rarr;</span>
											</a>
										</div>
									</div>
								))}
							</div>
						</section>
					)}

					<!-- Press & Media Recognition Section -->
					{projectMedia.length > 0 && (
						<section class="mt-10 pt-8 border-t border-[var(--border-subtle)] not-prose">
							<div class="flex items-center gap-3 mb-6">
								<div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
									<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
								</div>
								<div>
									<h3 class="text-xl font-semibold text-[var(--text-primary)]">{txt.mediaSection.title}</h3>
									<p class="text-xs text-[var(--text-muted)] font-mono">{txt.mediaSection.subtitle}</p>
								</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
								{projectMedia.map(media => (
									<div class="card-primary card-spotlight p-5 flex flex-col justify-between">
										<div>
											<div class="flex items-start justify-between gap-3 mb-2 text-xs font-mono">
												<span class="font-medium text-[var(--text-muted)]">{media.outlet}</span>
												<span class="font-semibold text-[var(--accent-primary)] shrink-0">{media.date}</span>
											</div>
											<h4 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] mb-2 leading-snug">{media.title}</h4>
										</div>

										<div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
											<div class="flex flex-wrap items-center gap-3">
												{media.articleUrl && (
													<a href={media.articleUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline">
														{txt.mediaSection.readArticleLabel}
													</a>
												)}
												{media.videoUrl && (
													<a href={media.videoUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline">
														{txt.mediaSection.watchVideoLabel}
													</a>
												)}
												{media.podcastUrl && (
													<a href={media.podcastUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline">
														{txt.mediaSection.podcastLabel}
													</a>
												)}
											</div>
											<a
												href={`/cv/media/${media.id}`}
												class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline font-semibold ml-auto inline-flex items-center gap-1"
											>
												<span>{txt.mediaSection.spotlightLabel}</span>
												<span>&rarr;</span>
											</a>
										</div>
									</div>
								))}
							</div>
						</section>
					)}
				</article>

				<!-- Sticky Table of Contents (Desktop Sidebar) -->
				{hasToc && (
					<aside class="hidden lg:block lg:col-span-4 sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto">
						<div class="surface-panel p-5">
							<h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-3 flex items-center gap-1.5">
								<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
								<span>{txt.tocHeading}</span>
							</h4>
							<nav class="space-y-1.5 text-xs">
								{tocHeadings.map(h => (
									<a
										href={`#${h.slug}`}
										class:list={[
											"block py-1 text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors truncate",
											h.depth === 3 ? "pl-3" : "font-semibold text-[var(--text-primary)]"
										]}
									>
										{h.text}
									</a>
								))}
							</nav>
						</div>
					</aside>
				)}
			</div>

			<!-- Previous & Next Project Navigation Cards -->
			{(prevProject || nextProject) && (
				<div class="mt-12 pt-8 border-t border-[var(--border-subtle)]">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						{prevProject && (
							<a
								href={`${detailBasePath}/${prevProject.id}`}
								class="project-card card-spotlight group p-4 flex-row items-center gap-3.5"
							>
								<div class="h-8 w-8 rounded-[2px] bg-[var(--bg-elevated)] border border-[var(--border-subtle)] flex items-center justify-center text-[var(--text-secondary)] group-hover:text-[var(--accent-primary)] group-hover:-translate-x-0.5 transition-transform shrink-0">
									&larr;
								</div>
								<div class="overflow-hidden">
									<span class="text-[11px] font-mono text-[var(--text-muted)] block">{txt.prevProjectLabel}</span>
									<span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors truncate block">
										{prevProject.data.title}
									</span>
								</div>
							</a>
						)}

						{nextProject && (
							<a
								href={`${detailBasePath}/${nextProject.id}`}
								class="project-card card-spotlight group p-4 flex-row items-center justify-end gap-3.5 text-right sm:ml-auto w-full"
							>
								<div class="overflow-hidden">
									<span class="text-[11px] font-mono text-[var(--text-muted)] block">{txt.nextProjectLabel}</span>
									<span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors truncate block">
										{nextProject.data.title}
									</span>
								</div>
								<div class="h-8 w-8 rounded-[2px] bg-[var(--bg-elevated)] border border-[var(--border-subtle)] flex items-center justify-center text-[var(--text-secondary)] group-hover:text-[var(--accent-primary)] group-hover:translate-x-0.5 transition-transform shrink-0">
									&rarr;
								</div>
							</a>
						)}
					</div>
				</div>
			)}
		</div>
	</div>

	<script>
		import { getProjectOrigin, getReturnScrollFor } from "../scripts/projectNavState";

		function syncProjectBackLink() {
			const link = document.getElementById("project-back-link") as HTMLAnchorElement | null;
			const label = document.getElementById("project-back-label");
			if (!link || !label) return;

			if (link.dataset.customBack === "1") {
				try {
					const targetUrl = new URL(link.href, window.location.origin);
					if (getReturnScrollFor(targetUrl.pathname) !== null) {
						link.href = targetUrl.pathname;
					}
				} catch {
					// Keep default href
				}
				return;
			}

			if (getProjectOrigin() === "home") {
				// Return to "/" directly so instant scroll restoration places the viewport at the exact previous scrollY
				link.href = getReturnScrollFor("/") !== null ? "/" : "/#projects";
				label.textContent = "Back to Home";
			} else if (getProjectOrigin() === "projects-hidden") {
				link.href = "/projects-hidden";
				label.textContent = "Back to Hidden Projects";
			}
		}

		document.addEventListener("astro:page-load", syncProjectBackLink);
	</script>
</BaseLayout>
