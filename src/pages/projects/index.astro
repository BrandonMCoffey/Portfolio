---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import {
  POPULAR_PROJECT_TECH,
  PROJECT_FILTER_DEFINITIONS,
  PROJECT_SORT_OPTIONS,
} from "../../data/projectsConfig";
import { SITE_PROFILE, formatTemplate } from "../../data/site";
import { loadSectionContent } from "../../utils/sectionContent";

const projects = await getCollection("projects");
projects.sort((a, b) => a.data.priority - b.data.priority);

const { data: copy, Content: ArchiveIntro } = await loadSectionContent("projects-archive");

const filterDefinitions = PROJECT_FILTER_DEFINITIONS.map((def) => {
  if (def.id === "all") {
    return { ...def, count: projects.length };
  }
  const tags = def.matchTags ?? [def.id];
  const count = projects.filter((p) => tags.some((tag) => p.data.filters?.includes(tag))).length;
  return { ...def, count };
});

const pageTitle = `${copy.metaTitlePrefix} | ${SITE_PROFILE.name}`;
const pageDescription = formatTemplate(copy.metaDescriptionTemplate, {
  count: projects.length,
  author: SITE_PROFILE.name,
});
const badgeCountText = formatTemplate(copy.badgeCountTemplate, { count: projects.length });
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="relative overflow-hidden py-16 sm:py-20">
    <!-- Background grid pattern -->
    <div
      class="pointer-events-none absolute inset-0 bg-grid-pattern opacity-40 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
    >
    </div>

    <div class="container relative mx-auto px-4 max-w-6xl">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="tag-accent gap-1.5 px-3 py-1.5 text-xs mb-4">
          <span>{copy.badgeLabel}</span>
          <span>//</span>
          <span id="header-project-count">{badgeCountText}</span>
        </div>
        <h1 class="mb-4">{copy.title}</h1>
        <div class="token-prose text-base sm:text-lg text-[var(--text-secondary)] max-w-2xl mx-auto [&>p]:m-0">
          <ArchiveIntro />
        </div>
      </div>

      <!-- Search & Control Panel -->
      <div class="surface-panel mb-10 space-y-4 p-5 sm:p-6">
        <!-- Top row: Search input & Sort selector -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
          <div class="relative flex-1 max-w-xl">
            <svg
              class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[var(--text-muted)]"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
              ></path>
            </svg>
            <input
              type="search"
              id="project-search-input"
              placeholder={copy.searchPlaceholder}
              class="w-full pl-10 pr-9 py-2.5 rounded-[3px] border border-[var(--border-strong)] bg-[var(--bg-page)] text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-primary)] transition-colors"
            />
            <button
              id="search-clear-btn"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs font-bold p-1 cursor-pointer"
              aria-label={copy.clearSearchAriaLabel}
            >
              &times;
            </button>
          </div>

          <!-- Sort Select -->
          <div class="flex items-center gap-2 self-end sm:self-auto text-xs font-mono text-[var(--text-muted)]">
            <label for="project-sort-select" class="whitespace-nowrap">{copy.sortLabel}</label>
            <select
              id="project-sort-select"
              class="py-2 px-3 rounded-[3px] border border-[var(--border-strong)] bg-[var(--bg-page)] text-[var(--text-primary)] text-xs font-mono focus:outline-none focus:border-[var(--accent-primary)]"
            >
              {PROJECT_SORT_OPTIONS.map((opt) => <option value={opt.value}>{opt.label}</option>)}
            </select>
          </div>
        </div>

        <!-- Category Filters -->
        <div class="pt-3 border-t border-[var(--border-subtle)]">
          <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
            <span class="text-xs font-mono uppercase tracking-wider text-[var(--text-muted)] mr-1 hidden sm:inline">
              {copy.categoryLabel}
            </span>
            {
              filterDefinitions.map((f) => (
                <button
                  type="button"
                  data-category-filter={f.id.toLowerCase()}
                  class:list={["category-filter-btn filter-pill shrink-0", f.id.toLowerCase() === "all" ? "active" : ""]}
                >
                  <span>{f.label}</span>
                  <span class="filter-count text-[10px] opacity-75 font-mono">({f.count})</span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Tech Stack Quick Filter Chips -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs">
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mr-1 hidden sm:inline">
            {copy.techLabel}
          </span>
          {
            POPULAR_PROJECT_TECH.map((tech) => (
              <button
                type="button"
                data-tech-filter={tech}
                class="tech-filter-chip shrink-0 px-2.5 py-1 rounded-[2px] text-[11px] font-mono font-medium border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-secondary)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] transition-colors cursor-pointer"
              >
                +{tech}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Live Results Counter Bar -->
      <div class="flex items-center justify-between mb-6 px-1 text-xs text-[var(--text-muted)] font-mono">
        <div>
          {copy.showingPrefix}{" "}
          <span id="visible-project-count" class="font-bold text-[var(--text-primary)]">{projects.length}</span>{" "}
          {copy.showingMiddle} {projects.length} {copy.showingSuffix}
        </div>
        <button id="reset-all-btn" class="hidden text-[var(--accent-primary)] hover:underline cursor-pointer font-mono font-semibold">
          {copy.resetLabel}
        </button>
      </div>

      <!-- Cards Grid -->
      <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          projects.map((project) => (
            <div
              class="project-item-card h-full"
              data-title={project.data.title.toLowerCase()}
              data-tagline={project.data.tagline.toLowerCase()}
              data-role={(project.data.role || "").toLowerCase()}
              data-year={project.data.year}
              data-priority={project.data.priority}
              data-tech={(project.data.tech || []).join(" ").toLowerCase()}
              data-platform={(project.data.platform || []).join(" ").toLowerCase()}
              data-filters={(project.data.filters || []).join(" ").toLowerCase()}
            >
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>

      <!-- Zero Results Placeholder -->
      <div id="no-projects-found" class="hidden py-16 text-center border border-dashed border-[var(--border-strong)] bg-[var(--bg-surface)] p-8 my-8">
        <p class="text-4xl mb-3">{copy.emptyEmoji}</p>
        <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-2">{copy.emptyTitle}</h3>
        <p class="text-sm text-[var(--text-muted)] max-w-md mx-auto mb-6">
          {copy.emptyDescription}
        </p>
        <button id="clear-search-btn" class="btn btn-secondary text-xs px-4 py-2">{copy.emptyCtaLabel}</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tech-filter-chip.active {
    background-color: var(--accent-primary);
    color: var(--accent-primary-fg);
    border-color: var(--accent-primary);
    font-weight: 700;
  }
</style>

<script>
  import { DEFAULT_PROJECT_PRIORITY } from "../../consts";

  function initProjectExplorer() {
    const searchInput = document.getElementById("project-search-input") as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById("search-clear-btn");
    const sortSelect = document.getElementById("project-sort-select") as HTMLSelectElement | null;
    const categoryBtns = document.querySelectorAll<HTMLButtonElement>(".category-filter-btn");
    const techChips = document.querySelectorAll<HTMLButtonElement>(".tech-filter-chip");
    const projectCards = document.querySelectorAll<HTMLElement>(".project-item-card");
    const visibleCountSpan = document.getElementById("visible-project-count");
    const resetAllBtn = document.getElementById("reset-all-btn");
    const noResults = document.getElementById("no-projects-found");
    const clearAllBtn = document.getElementById("clear-search-btn");
    const grid = document.getElementById("project-grid");

    if (!grid || grid.dataset.hasListener) return;
    grid.dataset.hasListener = "true";

    let activeCategory = "all";
    let activeTech = "";
    let currentSearch = "";
    let currentSort = "priority_asc";

    const updateCategoryPillStyles = (activeCat: string) => {
      const normCat = activeCat.toLowerCase();
      categoryBtns.forEach((b) => {
        const btnCat = (b.dataset.categoryFilter || "").toLowerCase();
        b.classList.toggle("active", btnCat === normCat);
      });
    };

    const updateTechChipStyles = (techFilter: string) => {
      const normTech = techFilter.toLowerCase();
      techChips.forEach((c) => {
        const isChipActive = normTech !== "" && (c.dataset.techFilter || "").toLowerCase() === normTech;
        c.classList.toggle("active", isChipActive);
      });
    };

    const urlParams = new URLSearchParams(window.location.search);
    const initialFilter = urlParams.get("filter");
    const initialTech = urlParams.get("tech");
    const initialSearch = urlParams.get("q");

    if (initialFilter) {
      const normFilter = initialFilter.toLowerCase();
      const matchingBtn = Array.from(categoryBtns).find((b) => (b.dataset.categoryFilter || "").toLowerCase() === normFilter);
      if (matchingBtn) {
        activeCategory = normFilter;
        updateCategoryPillStyles(activeCategory);
      }
    }

    if (initialTech) {
      const normTech = initialTech.toLowerCase();
      const matchingChip = Array.from(techChips).find((c) => (c.dataset.techFilter || "").toLowerCase() === normTech);
      if (matchingChip) {
        activeTech = normTech;
        updateTechChipStyles(activeTech);
      }
    }

    if (initialSearch) {
      currentSearch = initialSearch;
      if (searchInput) {
        searchInput.value = initialSearch;
        if (clearSearchBtn) clearSearchBtn.classList.remove("hidden");
      }
    }

    const updateUrl = () => {
      const params = new URLSearchParams();
      if (activeCategory !== "all") params.set("filter", activeCategory);
      if (activeTech) params.set("tech", activeTech);
      if (currentSearch) params.set("q", currentSearch);
      const queryString = params.toString();
      const newUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
      window.history.replaceState({}, "", newUrl);
    };

    const filterAndSortCards = () => {
      let visibleCount = 0;
      const cardsArray = Array.from(projectCards);

      cardsArray.forEach((card) => {
        const title = card.dataset.title || "";
        const tagline = card.dataset.tagline || "";
        const role = card.dataset.role || "";
        const tech = card.dataset.tech || "";
        const platform = card.dataset.platform || "";
        const filters = card.dataset.filters || "";

        let matchesCategory = false;
        if (activeCategory === "all") {
          matchesCategory = true;
        } else if (activeCategory === "vr") {
          matchesCategory = filters.includes("vr") || filters.includes("ar");
        } else {
          matchesCategory = filters.includes(activeCategory.toLowerCase());
        }

        const matchesTech = activeTech ? tech.includes(activeTech) : true;
        let matchesSearch = true;
        if (currentSearch) {
          const query = currentSearch.toLowerCase();
          matchesSearch =
            title.includes(query) ||
            tagline.includes(query) ||
            role.includes(query) ||
            tech.includes(query) ||
            platform.includes(query) ||
            filters.includes(query);
        }

        const isVisible = matchesCategory && matchesTech && matchesSearch;
        card.style.display = isVisible ? "" : "none";
        if (isVisible) visibleCount++;
      });

      cardsArray.sort((a, b) => {
        const prioA = Number(a.dataset.priority ?? DEFAULT_PROJECT_PRIORITY);
        const prioB = Number(b.dataset.priority ?? DEFAULT_PROJECT_PRIORITY);
        const yearA = Number(a.dataset.year || "0");
        const yearB = Number(b.dataset.year || "0");
        const titleA = a.dataset.title || "";
        const titleB = b.dataset.title || "";

        switch (currentSort) {
          case "year_desc":
            return yearB - yearA;
          case "year_asc":
            return yearA - yearB;
          case "title_asc":
            return titleA.localeCompare(titleB);
          case "priority_asc":
          default:
            return prioA - prioB;
        }
      });

      cardsArray.forEach((card) => grid.appendChild(card));

      if (visibleCountSpan) visibleCountSpan.textContent = String(visibleCount);
      if (noResults) noResults.classList.toggle("hidden", visibleCount > 0);
      if (resetAllBtn) {
        const isFiltered = activeCategory !== "all" || activeTech !== "" || currentSearch.length > 0;
        resetAllBtn.classList.toggle("hidden", !isFiltered);
      }

      updateUrl();
    };

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = (btn.dataset.categoryFilter || "all").toLowerCase();
        updateCategoryPillStyles(activeCategory);
        filterAndSortCards();
      });
    });

    techChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const clickedTech = (chip.dataset.techFilter || "").toLowerCase();
        activeTech = activeTech === clickedTech ? "" : clickedTech;
        updateTechChipStyles(activeTech);
        filterAndSortCards();
      });
    });

    searchInput?.addEventListener("input", () => {
      currentSearch = searchInput.value.trim();
      if (clearSearchBtn) clearSearchBtn.classList.toggle("hidden", !currentSearch);
      filterAndSortCards();
    });

    clearSearchBtn?.addEventListener("click", () => {
      if (searchInput) {
        searchInput.value = "";
        currentSearch = "";
        clearSearchBtn.classList.add("hidden");
        filterAndSortCards();
      }
    });

    sortSelect?.addEventListener("change", () => {
      currentSort = sortSelect.value;
      filterAndSortCards();
    });

    const resetFilters = () => {
      activeCategory = "all";
      activeTech = "";
      currentSearch = "";
      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.classList.add("hidden");

      updateCategoryPillStyles("all");
      updateTechChipStyles("");
      filterAndSortCards();
    };

    resetAllBtn?.addEventListener("click", resetFilters);
    clearAllBtn?.addEventListener("click", resetFilters);

    if (initialFilter || initialTech || initialSearch) {
      filterAndSortCards();
    }
  }

  document.addEventListener("astro:page-load", initProjectExplorer);
</script>
