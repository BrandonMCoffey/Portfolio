---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  education,
  publications,
  awards,
  mediaRecognition,
  eventsAndShowcases,
  teachingExperience,
  CV_PUBLICATION_VENUES,
  getCvMetrics,
} from "../data/cvData";
import { SITE_PROFILE, formatTemplate } from "../data/site";
import { loadSectionContent } from "../utils/sectionContent";

const cvSection = await loadSectionContent("cv-page");
const copy = cvSection.data;
const metrics = getCvMetrics();
const { totalPapers, totalAwards, daveyAwardsCount, totalMedia, totalShowcases, grants: grantTotals } = metrics;

const pageTitle = `${copy.metaTitlePrefix} | ${SITE_PROFILE.name}`;
const pageDescription = formatTemplate(copy.metaDescriptionTemplate, {
  grantsShort: grantTotals.shortCombined,
  author: SITE_PROFILE.name,
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="relative overflow-x-clip py-10 sm:py-16">
    <div class="container mx-auto px-4 max-w-5xl">
      <!-- Breadcrumb & Print Action -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8 print:hidden">
        <nav class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
          <a href="/" class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors">{copy.breadcrumbHome}</a>
          <span>/</span>
          <span class="text-[var(--text-primary)] font-semibold">{copy.breadcrumbCurrent}</span>
        </nav>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="print-cv-btn"
            class="btn btn-primary px-3.5 py-1.5 text-xs"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            <span>{copy.printButtonLabel}</span>
          </button>
        </div>
      </div>

      <!-- CV Header -->
      <header class="cv-header mb-12 pb-8 border-b border-[var(--border-subtle)]">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-[var(--accent-primary)] mb-2 block">
              {copy.eyebrow}
            </span>
            <h1 class="text-4xl sm:text-5xl">{SITE_PROFILE.name}</h1>
            <p class="text-lg sm:text-xl text-[var(--text-secondary)] font-medium mt-2">{SITE_PROFILE.researchRole}</p>
            <p class="text-sm text-[var(--text-muted)] mt-1">
              {SITE_PROFILE.affiliation}
            </p>
          </div>

          <div class="flex flex-col sm:flex-row md:flex-col gap-2 text-xs font-mono text-[var(--text-secondary)]">
            <a
              href={`mailto:${SITE_PROFILE.email}`}
              class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors flex items-center gap-1.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3.5 w-3.5 text-[var(--accent-primary)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
              >
              <span>{SITE_PROFILE.email}</span>
            </a>
            <a
              href={SITE_PROFILE.orcid.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors flex items-center gap-1.5"
            >
              <svg class="h-3.5 w-3.5 text-[#A6CE39] fill-current" viewBox="0 0 256 256">
                <path d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z" fill="#A6CE39"></path>
                <path
                  d="M86.3 186.2H70.9V79.1h15.4v107.1zM78.6 65.3c-5.7 0-10.3-4.6-10.3-10.3s4.6-10.3 10.3-10.3 10.3 4.6 10.3 10.3-4.6 10.3-10.3 10.3zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4z"
                  fill="#FFF"></path>
              </svg>
              <span>{SITE_PROFILE.orcid.display}</span>
            </a>
            <a
              href={SITE_PROFILE.linkedin.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors flex items-center gap-1.5"
            >
              <svg class="h-3.5 w-3.5 text-[var(--accent-primary)]" viewBox="0 0 16 16" fill="currentColor"
                ><path
                  d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
                ></path></svg
              >
              <span>{SITE_PROFILE.linkedin.display}</span>
            </a>
            <a
              href={SITE_PROFILE.github.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--accent-primary)] transition-colors flex items-center gap-1.5"
            >
              <svg class="h-3.5 w-3.5 text-[var(--accent-primary)]" viewBox="0 0 16 16" fill="currentColor"
                ><path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                ></path></svg
              >
              <span>{SITE_PROFILE.github.display}</span>
            </a>
            <span class="text-[var(--text-muted)] flex items-center gap-1.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3.5 w-3.5 text-[var(--accent-primary)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg
              >
              <span>{SITE_PROFILE.location}</span>
            </span>
          </div>
        </div>

        <!-- High-Impact CV Metrics Bar -->
        <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 print:hidden">
          <a
            href="#publications"
            class="card-primary card-spotlight group p-4 block cursor-pointer"
            title={copy.metrics.publications.title}
          >
            <span class="text-2xl sm:text-3xl font-bold text-[var(--accent-primary)] font-mono block group-hover:translate-x-0.5 transition-transform">
              {totalPapers}
            </span>
            <span class="text-xs font-semibold text-[var(--text-primary)] flex items-center justify-between mt-1">
              <span>{copy.metrics.publications.label}</span>
              <svg class="h-3 w-3 text-[var(--accent-primary)] opacity-0 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m19.5 8.25-7.5 7.5-7.5-7.5"></path></svg>
            </span>
            <span class="text-[10px] text-[var(--text-muted)] block font-mono mt-0.5">{copy.metrics.publications.summary}</span>
          </a>

          <a
            href="#awards"
            class="card-primary card-spotlight group p-4 block cursor-pointer"
            title={copy.metrics.awards.title}
          >
            <span class="text-2xl sm:text-3xl font-bold text-[var(--accent-primary)] font-mono block group-hover:translate-x-0.5 transition-transform">
              {totalAwards}
            </span>
            <span class="text-xs font-semibold text-[var(--text-primary)] flex items-center justify-between mt-1">
              <span>{copy.metrics.awards.label}</span>
              <svg class="h-3 w-3 text-[var(--accent-primary)] opacity-0 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m19.5 8.25-7.5 7.5-7.5-7.5"></path></svg>
            </span>
            <span class="text-[10px] text-[var(--text-muted)] block font-mono mt-0.5">
              {formatTemplate(copy.metrics.awards.summaryTemplate, { daveyCount: daveyAwardsCount })}
            </span>
          </a>

          <a
            href="#media"
            class="card-primary card-spotlight group p-4 block cursor-pointer"
            title={copy.metrics.media.title}
          >
            <span class="text-2xl sm:text-3xl font-bold text-[var(--accent-primary)] font-mono block group-hover:translate-x-0.5 transition-transform">
              {totalMedia}
            </span>
            <span class="text-xs font-semibold text-[var(--text-primary)] flex items-center justify-between mt-1">
              <span>{copy.metrics.media.label}</span>
              <svg class="h-3 w-3 text-[var(--accent-primary)] opacity-0 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m19.5 8.25-7.5 7.5-7.5-7.5"></path></svg>
            </span>
            <span class="text-[10px] text-[var(--text-muted)] block font-mono mt-0.5">{copy.metrics.media.summary}</span>
          </a>

          <a
            href="#exhibitions"
            class="card-primary card-spotlight group p-4 block cursor-pointer"
            title={copy.metrics.exhibitions.title}
          >
            <span class="text-2xl sm:text-3xl font-bold text-[var(--accent-primary)] font-mono block group-hover:translate-x-0.5 transition-transform">
              {totalShowcases}+
            </span>
            <span class="text-xs font-semibold text-[var(--text-primary)] flex items-center justify-between mt-1">
              <span>{copy.metrics.exhibitions.label}</span>
              <svg class="h-3 w-3 text-[var(--accent-primary)] opacity-0 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m19.5 8.25-7.5 7.5-7.5-7.5"></path></svg>
            </span>
            <span class="text-[10px] text-[var(--text-muted)] block font-mono mt-0.5">{copy.metrics.exhibitions.summary}</span>
          </a>
        </div>
      </header>

      <!-- 1. EDUCATION & ACADEMIC APPOINTMENTS -->
      <section id="education" class="mb-16 scroll-mt-28 py-0">
        <div class="flex items-center gap-3 mb-7">
          <div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg
            >
          </div>
          <div>
            <h2 class="text-2xl">{copy.sections.education.title}</h2>
            <p class="text-xs text-[var(--text-muted)] font-mono">{copy.sections.education.subtitle}</p>
          </div>
        </div>

        <div class="space-y-5">
          {
            education.map((item) => (
              <div class="card-primary card-spotlight p-5 sm:p-6">
                <div class="flex items-start justify-between gap-3 mb-1.5">
                  <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] leading-snug">{item.degree}</h3>
                  <span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{item.period}</span>
                </div>
                <p class="text-sm font-semibold text-[var(--text-secondary)] mb-2">{item.institution}</p>
                {item.notes && <p class="text-xs text-[var(--text-muted)] leading-relaxed">{item.notes}</p>}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 2. PEER-REVIEWED PUBLICATIONS -->
      <section id="publications" class="mb-16 scroll-mt-28 py-0">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                ><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"
                ></path></svg
              >
            </div>
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <h2 class="text-2xl">{copy.sections.publications.title}</h2>
                <a
                  href={SITE_PROFILE.orcid.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tag-square gap-1.5 hover:border-[var(--accent-primary)]"
                  title={SITE_PROFILE.orcid.label}
                >
                  <svg class="h-3.5 w-3.5 fill-[#A6CE39]" viewBox="0 0 256 256">
                    <path d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z" fill="#A6CE39"></path>
                    <path
                      d="M86.3 186.2H70.9V79.1h15.4v107.1zM78.6 65.3c-5.7 0-10.3-4.6-10.3-10.3s4.6-10.3 10.3-10.3 10.3 4.6 10.3 10.3-4.6 10.3-10.3 10.3zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4z"
                      fill="#FFF"></path>
                  </svg>
                  <span>ORCID: {SITE_PROFILE.orcid.id}</span>
                </a>
              </div>
              <p class="text-xs text-[var(--text-muted)] font-mono mt-0.5">
                {formatTemplate(copy.sections.publications.subtitleTemplate, { count: totalPapers })}
              </p>
            </div>
          </div>

          <div id="pub-filter-container" class="flex items-center gap-1.5 flex-wrap print:hidden text-xs font-mono">
            <button type="button" data-pub-filter="all" class="pub-filter-btn filter-pill active cursor-pointer">
              {copy.sections.publications.allFilterLabel} ({totalPapers})
            </button>
            {
              CV_PUBLICATION_VENUES.map((venue) => (
                <button type="button" data-pub-filter={venue} class="pub-filter-btn filter-pill cursor-pointer">
                  {venue}
                </button>
              ))
            }
          </div>
        </div>

        <div class="space-y-5" id="publications-list">
          {
            publications.map((pub, idx) => (
              <article class="pub-card card-primary card-spotlight p-5 sm:p-6" data-venue={pub.venue}>
                <div class="flex items-start justify-between gap-3 mb-2">
                  <span class="text-xs font-mono font-medium text-[var(--text-muted)]">
                    [{idx + 1}] {pub.venue}
                  </span>
                  <span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{pub.date}</span>
                </div>

                <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] mb-2 leading-snug">{pub.title}</h3>

                <p class="text-xs font-mono text-[var(--text-muted)] mb-1">
                  {copy.sections.publications.rolesPrefix} <strong class="text-[var(--text-secondary)]">{pub.roles}</strong>
                </p>

                <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                  <div class="flex flex-wrap items-center gap-3">
                    {pub.doi && (
                      <a
                        href={pub.doi}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                      >
                        {copy.sections.publications.doiPrefix} {pub.doi.replace("https://doi.org/", "").replace("https://dl.acm.org/doi/", "")}
                      </a>
                    )}

                    {pub.paperUrl && (
                      <a
                        href={pub.paperUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                      >
                        {copy.sections.publications.officialPdfLabel}
                      </a>
                    )}

                    {pub.extraUrl && (
                      <a
                        href={pub.extraUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                      >
                        {copy.sections.publications.archiveLabel}
                      </a>
                    )}
                  </div>

                  {pub.projectSlug && (
                    <a
                      href={`/cv/publications/${pub.id}`}
                      class="inline-flex items-center gap-1 ml-auto font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors print:hidden"
                    >
                      <span>{copy.sections.publications.caseStudyLabel}</span>
                      <span>&rarr;</span>
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>

        <div id="pub-reset-container" class="mt-6 text-center hidden print:hidden">
          <button
            type="button"
            id="pub-reset-btn"
            class="btn btn-primary px-4 py-2 text-xs"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path
                d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg
            >
            <span>{copy.sections.publications.resetButtonLabel}</span>
          </button>
        </div>
      </section>

      <!-- 4. HONORS & AWARDS -->
      <section id="awards" class="mb-16 scroll-mt-28 py-0">
        <div class="flex items-center gap-3 mb-7">
          <div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg
            >
          </div>
          <div>
            <h2 class="text-2xl">{copy.sections.awards.title}</h2>
            <p class="text-xs text-[var(--text-muted)] font-mono">{formatTemplate(copy.sections.awards.subtitleTemplate, { count: totalAwards })}</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {
            awards.map((award) => (
              <div class="card-primary card-spotlight p-5 sm:p-6 flex flex-col justify-between">
                <div>
                  <div class="flex items-start justify-between gap-3 mb-2">
                    <span class="text-xs font-mono font-medium text-[var(--text-muted)]">{award.organization}</span>
                    <span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{award.year}</span>
                  </div>

                  <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] mb-2 leading-snug">{award.title}</h3>

                  <p class="text-xs text-[var(--text-secondary)]">
                    {copy.sections.awards.projectPrefix} <strong class="text-[var(--text-primary)]">{award.project}</strong>
                  </p>
                </div>

                {(award.url || award.projectSlug) && (
                  <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                    {award.url ? (
                      <a
                        href={award.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                      >
                        {copy.sections.awards.galleryLabel}
                      </a>
                    ) : (
                      <span />
                    )}

                    {award.projectSlug && (
                      <a
                        href={`/projects/${award.projectSlug}`}
                        class="inline-flex items-center gap-1 ml-auto font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors print:hidden"
                      >
                        <span>{copy.sections.awards.caseStudyLabel}</span>
                        <span>&rarr;</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 5. PRESS & MEDIA RECOGNITION -->
      <section id="media" class="mb-16 scroll-mt-28 py-0">
        <div class="flex items-center gap-3 mb-7">
          <div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"
              ></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path></svg
            >
          </div>
          <div>
            <h2 class="text-2xl">{copy.sections.media.title}</h2>
            <p class="text-xs text-[var(--text-muted)] font-mono">{formatTemplate(copy.sections.media.subtitleTemplate, { count: totalMedia })}</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {
            mediaRecognition.map((media) => (
              <div class="card-primary card-spotlight p-5 sm:p-6 flex flex-col justify-between">
                <div>
                  <div class="flex items-start justify-between gap-3 mb-2">
                    <span class="text-xs font-mono font-medium text-[var(--text-muted)]">{media.outlet}</span>
                    <span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{media.date}</span>
                  </div>

                  <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] leading-snug">{media.title}</h3>
                </div>

                {(media.articleUrl || media.videoUrl || media.podcastUrl || media.projectSlug) && (
                  <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                    <div class="flex flex-wrap items-center gap-3">
                      {media.articleUrl && (
                        <a
                          href={media.articleUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                        >
                          {copy.sections.media.readArticleLabel}
                        </a>
                      )}

                      {media.videoUrl && (
                        <a
                          href={media.videoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                        >
                          {copy.sections.media.watchVideoLabel}
                        </a>
                      )}

                      {media.podcastUrl && (
                        <a
                          href={media.podcastUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                        >
                          {copy.sections.media.listenPodcastLabel}
                        </a>
                      )}
                    </div>

                    {media.projectSlug && (
                      <a
                        href={`/cv/media/${media.id}`}
                        class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline ml-auto print:hidden font-semibold inline-flex items-center gap-1 transition-colors"
                      >
                        <span>{copy.sections.media.spotlightLabel}</span>
                        <span>&rarr;</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 6. EXHIBITIONS & ACADEMIC CONFERENCES -->
      <section id="exhibitions" class="mb-16 scroll-mt-28 py-0">
        <div class="flex items-center gap-3 mb-7">
          <div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M2 3h20"></path><path d="M21 3v18H3V3"></path><path d="m9 8 3 3-3 3"></path><path d="M15 14h-3"></path></svg
            >
          </div>
          <div>
            <h2 class="text-2xl">{copy.sections.exhibitions.title}</h2>
            <p class="text-xs text-[var(--text-muted)] font-mono">{formatTemplate(copy.sections.exhibitions.subtitleTemplate, { count: totalShowcases })}</p>
          </div>
        </div>

        <div class="space-y-4">
          {
            eventsAndShowcases.map((event) => (
              <div class="card-primary card-spotlight p-5 sm:p-6">
                <div class="flex items-start justify-between gap-3 mb-1.5">
                  <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] leading-snug">{event.title}</h3>
                  <span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{event.date}</span>
                </div>
                <p class="text-xs text-[var(--text-secondary)]">
                  {copy.sections.exhibitions.featuredWorkPrefix} <strong class="text-[var(--text-primary)]">{event.project}</strong> &bull; {event.location}
                </p>
                {event.url && (
                  <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-mono">
                    <a
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] hover:underline transition-colors"
                    >
                      View Event
                    </a>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 8. TEACHING EXPERIENCE & SERVICE -->
      <section id="teaching" class="mb-16 scroll-mt-28 py-0">
        <div class="flex items-center gap-3 mb-7">
          <div class="p-2 rounded-[2px] bg-[var(--accent-badge-bg)] text-[var(--accent-primary)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg
            >
          </div>
          <div>
            <h2 class="text-2xl">{copy.sections.teaching.title}</h2>
            <p class="text-xs text-[var(--text-muted)] font-mono">{copy.sections.teaching.subtitle}</p>
          </div>
        </div>

        <div class="space-y-5">
          {
            teachingExperience.map((item) => (
              <div class="card-primary card-spotlight p-5 sm:p-6">
                <div class="flex items-start justify-between gap-3 mb-1.5">
                  <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] leading-snug">
                    {item.role} &mdash; <span class="text-[var(--text-secondary)] font-normal">{item.courseOrEvent}</span>
                  </h3>
                  <span class="text-xs font-mono font-semibold text-[var(--accent-primary)] shrink-0">{item.term}</span>
                </div>
                <p class="text-xs font-mono text-[var(--text-muted)]">{item.institution}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <!-- Print Stylesheet & Interactivity Script -->
  <style>
    @media print {
      :global(.site-header),
      :global(.site-footer),
      :global(#scroll-to-top),
      :global(.scroll-to-top),
      .print\:hidden {
        display: none !important;
      }

      :global(html),
      :global(body) {
        background: #ffffff !important;
        background-color: #ffffff !important;
        color: #151515 !important;
        font-size: 10pt !important;
        line-height: 1.4 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .cv-header {
        display: block !important;
        margin-bottom: 1.5rem !important;
        padding-bottom: 1rem !important;
        border-bottom: 2px solid #dddcd6 !important;
      }

      :global(.surface-panel),
      :global(.surface-card),
      :global(.card-primary),
      article,
      .pub-card {
        background: #ffffff !important;
        background-color: #ffffff !important;
        border: 1px solid #dddcd6 !important;
        border-radius: 3px !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        margin-bottom: 0.75rem !important;
        padding: 0.75rem 1rem !important;
      }

      :global(h1) {
        font-size: 24pt !important;
        color: #151515 !important;
        margin-bottom: 0.25rem !important;
      }

      :global(h2) {
        font-size: 14pt !important;
        color: #151515 !important;
        page-break-after: avoid !important;
        break-after: avoid !important;
        margin-bottom: 0.5rem !important;
      }

      :global(h3) {
        font-size: 11pt !important;
        color: #151515 !important;
        page-break-after: avoid !important;
        break-after: avoid !important;
      }

      :global(p),
      :global(span),
      :global(li),
      :global(time) {
        color: #3f3f3f !important;
      }

      :global(.pill-date) {
        background: #eaeae6 !important;
        color: #3f3f3f !important;
        border: 1px solid #dddcd6 !important;
        font-size: 8.5pt !important;
        padding: 0.1rem 0.4rem !important;
      }

      :global(a) {
        color: #d94916 !important;
        text-decoration: none !important;
      }

      section {
        break-inside: auto;
        margin-bottom: 1.75rem !important;
      }
    }
  </style>

  <script>
    function setupCvInteractions() {
      const printBtn = document.getElementById("print-cv-btn");
      if (printBtn && !printBtn.dataset.hasListener) {
        printBtn.dataset.hasListener = "true";
        printBtn.addEventListener("click", () => {
          window.print();
        });
      }

      if (!(window as any).__cvPrintListenersAttached) {
        (window as any).__cvPrintListenersAttached = true;
        let wasDarkBeforePrint = false;

        window.addEventListener("beforeprint", () => {
          wasDarkBeforePrint = document.documentElement.classList.contains("dark");
          if (wasDarkBeforePrint) {
            document.documentElement.classList.remove("dark");
          }
        });

        window.addEventListener("afterprint", () => {
          if (wasDarkBeforePrint) {
            document.documentElement.classList.add("dark");
          }
        });
      }

      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".pub-filter-btn");
      const pubCards = document.querySelectorAll<HTMLElement>(".pub-card");
      const resetBtn = document.getElementById("pub-reset-btn");
      const resetContainer = document.getElementById("pub-reset-container");

      const applyPubFilter = (targetVenue: string, updateUrlState: boolean = true) => {
        const normTarget = targetVenue.toLowerCase();

        filterBtns.forEach((b) => {
          const btnFilter = (b.dataset.pubFilter || "").toLowerCase();
          const isActive = btnFilter === normTarget || (normTarget === "all" && btnFilter === "all");
          b.classList.toggle("active", isActive);
        });

        pubCards.forEach((card) => {
          const venue = (card.dataset.venue || "").toLowerCase();
          const matches = normTarget === "all" || venue.includes(normTarget);
          card.style.display = matches ? "block" : "none";
        });

        if (resetContainer) {
          resetContainer.classList.toggle("hidden", normTarget === "all");
        }

        if (updateUrlState) {
          const currentUrl = new URL(window.location.href);
          if (normTarget === "all") {
            currentUrl.searchParams.delete("venue");
            currentUrl.searchParams.delete("filter");
          } else {
            currentUrl.searchParams.set("venue", targetVenue);
          }
          window.history.replaceState({}, "", currentUrl.toString());
        }
      };

      if (filterBtns.length > 0 && pubCards.length > 0) {
        filterBtns.forEach((btn) => {
          if (btn.dataset.hasFilterListener) return;
          btn.dataset.hasFilterListener = "true";

          btn.addEventListener("click", () => {
            const target = btn.dataset.pubFilter || "all";
            applyPubFilter(target, true);
          });
        });

        const urlParams = new URLSearchParams(window.location.search);
        const initialVenue = urlParams.get("venue") || urlParams.get("filter");
        if (initialVenue) {
          const normInitial = initialVenue.toLowerCase();
          const matchedBtn = Array.from(filterBtns).find((b) => (b.dataset.pubFilter || "").toLowerCase() === normInitial);
          if (matchedBtn) {
            applyPubFilter(matchedBtn.dataset.pubFilter || "all", false);
          }
        }
      }

      if (resetBtn && !resetBtn.dataset.hasResetListener) {
        resetBtn.dataset.hasResetListener = "true";
        resetBtn.addEventListener("click", () => {
          applyPubFilter("all", true);
        });
      }
    }

    document.addEventListener("astro:page-load", setupCvInteractions);
  </script>
</BaseLayout>
