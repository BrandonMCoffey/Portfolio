  <script>
    function setupCvInteractions() {
      // Print button handler
      const printBtn = document.getElementById("print-cv-btn");
      if (printBtn && !printBtn.dataset.hasListener) {
        printBtn.dataset.hasListener = "true";
        printBtn.addEventListener("click", () => {
          window.print();
        });
      }

      // Handle beforeprint and afterprint to ensure clean light mode while printing
      if (!(window as any).__cvPrintListenersAttached) {
        (window as any).__cvPrintListenersAttached = true;
        let wasDarkBeforePrint = false;

        window.addEventListener("beforeprint", () => {
          wasDarkBeforePrint = document.documentElement.classList.contains("dark");
          if (wasDarkBeforePrint) {
            document.documentElement.classList.remove("dark");
          }
        });

        window.addEventListener("afterprint", () => {
          if (wasDarkBeforePrint) {
            document.documentElement.classList.add("dark");
          }
        });
      }

      // Publication venue filter
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".pub-filter-btn");
      const pubCards = document.querySelectorAll<HTMLElement>(".pub-card");
      const resetBtn = document.getElementById("pub-reset-btn");
      const resetContainer = document.getElementById("pub-reset-container");

      const applyPubFilter = (targetVenue: string, updateUrlState: boolean = true) => {
        const normTarget = targetVenue.toLowerCase();

        // Update button styles
        filterBtns.forEach((b) => {
          const btnFilter = (b.dataset.pubFilter || "").toLowerCase();
          const isActive = btnFilter === normTarget || (normTarget === "all" && btnFilter === "all");
          b.classList.toggle("active", isActive);
          b.classList.toggle("bg-emerald-600", isActive);
          b.classList.toggle("text-white", isActive);
          b.classList.toggle("bg-slate-100", !isActive);
          b.classList.toggle("dark:bg-slate-800", !isActive);
          b.classList.toggle("text-slate-700", !isActive);
          b.classList.toggle("dark:text-slate-300", !isActive);
        });

        // Filter cards
        pubCards.forEach((card) => {
          const venue = (card.dataset.venue || "").toLowerCase();
          const matches = normTarget === "all" || venue.includes(normTarget);
          card.style.display = matches ? "block" : "none";
        });

        // Toggle "Show All Publications" reset button
        if (resetContainer) {
          resetContainer.classList.toggle("hidden", normTarget === "all");
        }

        // Update URL query params via replaceState
        if (updateUrlState) {
          const currentUrl = new URL(window.location.href);
          if (normTarget === "all") {
            currentUrl.searchParams.delete("venue");
            currentUrl.searchParams.delete("filter");
          } else {
            currentUrl.searchParams.set("venue", targetVenue);
          }
          window.history.replaceState({}, "", currentUrl.toString());
        }
      };

      if (filterBtns.length > 0 && pubCards.length > 0) {
        filterBtns.forEach((btn) => {
          if (btn.dataset.hasFilterListener) return;
          btn.dataset.hasFilterListener = "true";

          btn.addEventListener("click", () => {
            const target = btn.dataset.pubFilter || "all";
            applyPubFilter(target, true);
          });
        });

        // Parse ?venue= or ?filter= from window.location.search on load
        const urlParams = new URLSearchParams(window.location.search);
        const initialVenue = urlParams.get("venue") || urlParams.get("filter");
        if (initialVenue) {
          const normInitial = initialVenue.toLowerCase();
          const matchedBtn = Array.from(filterBtns).find((b) => (b.dataset.pubFilter || "").toLowerCase() === normInitial);
          if (matchedBtn) {
            applyPubFilter(matchedBtn.dataset.pubFilter || "all", false);
          }
        }
      }

      // Show all publications reset button listener
      if (resetBtn && !resetBtn.dataset.hasResetListener) {
        resetBtn.dataset.hasResetListener = "true";
        resetBtn.addEventListener("click", () => {
          applyPubFilter("all", true);
        });
      }
    }

    document.addEventListener("astro:page-load", setupCvInteractions);
  </script>
